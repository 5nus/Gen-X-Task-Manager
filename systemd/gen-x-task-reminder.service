[Unit]
Description=genxtask desktop reminders
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=oneshot
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
EnvironmentFile=-%h/.config/gen-x-task-manager/reminder.env
ExecStart=/usr/bin/python3 "%h/.local/bin/genxtask-reminder"
